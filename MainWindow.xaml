                                <Button Style="{StaticResource Pill}" Background="{StaticResource StoreBrush}" Content="Microsoft Store" Tag="ms-windows-store://search/?query=Halo%20Spartan%20Assault|Halo: Spartan Assault" Click="OpenUri_Click"/>
