                    HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="News" Style="{StaticResource BoxTitle}"/>
                        <Rectangle Height="3" Width="64" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Margin="1,12,0,14" Fill="{StaticResource CyanBrush}"/>
                    </StackPanel>
                    <ScrollViewer x:Name="NewsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" Padding="0,0,14,0">
                        <StackPanel x:Name="NewsList"/>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="NewsClose" Style="{StaticResource Pill}" Content="Close" Click="CloseNews_Click" HorizontalAlignment="Left" Margin="0"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#6B829C" FontSize="14"
                                   Text="↑ ↓  Scroll        ← →  Choose        Esc / B  Close"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

