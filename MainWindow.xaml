                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Width="600" VerticalAlignment="Top">
                <Border Style="{StaticResource BoxCached}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Start Halo MCC" Style="{StaticResource BoxTitle}"/>
