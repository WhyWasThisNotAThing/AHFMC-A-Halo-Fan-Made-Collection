                    <Button x:Name="CreditsClose" Style="{StaticResource Pill}" Content="Close" Click="CloseCredits_Click"
                            HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="NewsPane" Visibility="Collapsed" Background="#E6050810" MouseDown="NewsScrim_MouseDown"
              KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
