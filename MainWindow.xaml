                    </TextBlock>

                    <WrapPanel Margin="0,22,0,0">
                        <Button x:Name="CreditsFirst" Style="{StaticResource Pill}" Content="WhyWasThisNotAThing" Tag="https://github.com/WhyWasThisNotAThing" Click="CreditLink_Click" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource Pill}" Content="Project Reclaimer" Tag="https://github.com/ProjectReclaimer/project-reclaimer-releases" Click="CreditLink_Click" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource Pill}" Content="NETF1ix" Tag="https://github.com/NETF1ix/reach-renaissance-releases" Click="CreditLink_Click" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource Pill}" Content="Halo 2 Gravemind" Tag="https://github.com/BriRoz1/h2gravemind-releases/releases/" Click="CreditLink_Click" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource Pill}" Content="opencommunityedition.com" Tag="https://opencommunityedition.com/" Click="CreditLink_Click" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource Pill}" Content="Project Groundside Discord" Tag="https://discord.gg/nRusWYMdYu" Click="CreditLink_Click" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource Pill}" Content="Contact me" Tag="mailto:whywasthisnotathing@gmail.com" Click="CreditLink_Click" Margin="0,0,10,10"/>
