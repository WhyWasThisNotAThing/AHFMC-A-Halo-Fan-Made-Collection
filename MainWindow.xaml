                                <Button Style="{StaticResource Pill}" Background="{StaticResource StoreBrush}" Content="Microsoft Store" Tag="ms-windows-store://search/?query=Halo%20Spartan%20Strike|Halo: Spartan Strike" Click="OpenUri_Click"/>
