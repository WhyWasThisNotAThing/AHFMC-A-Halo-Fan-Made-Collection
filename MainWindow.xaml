<Window x:Class="AHFMC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AHFMC"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AHFMC: A Halo Fan-Made Collection" Icon="Assets/logo.ico"
        WindowStyle="None" ResizeMode="NoResize" Background="#070B12"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        MinWidth="900" MinHeight="560"
        Loaded="Window_Loaded" MouseLeftButtonDown="Window_DragStrip" KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged">

    <Window.Resources>
        <LinearGradientBrush x:Key="CyanBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8FE0FF" Offset="0"/><GradientStop Color="#2F7FD1" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFD779" Offset="0"/><GradientStop Color="#C98A1E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MintBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#9CF2D4" Offset="0"/><GradientStop Color="#2BA384" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SteamBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8AD3FF" Offset="0"/><GradientStop Color="#2A7DB8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="StoreBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B4F06A" Offset="0"/><GradientStop Color="#4C9F2A" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F93AA"/>
            <Setter Property="Text" Value="{Binding (local:Install.State), RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding (local:Install.State), RelativeSource={RelativeSource AncestorType=Button}}" Value="Installed">
                    <Setter Property="Foreground" Value="#7BD88F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (local:Install.State), RelativeSource={RelativeSource AncestorType=Button}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource CyanBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root">
                            <Grid.RenderTransform><TranslateTransform x:Name="shift" X="0"/></Grid.RenderTransform>
                            <Border x:Name="bg" CornerRadius="4" BorderBrush="#22FFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E0152236" Offset="0"/>
                                        <GradientStop Color="#E00D1626" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="bar" HorizontalAlignment="Left" Width="4" CornerRadius="4,0,0,4"
                                    Background="{TemplateBinding Background}"/>
                            <ContentPresenter Margin="26,0,56,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="arrow" Text="›" FontSize="40" Foreground="{TemplateBinding Background}" Opacity="0.30"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,6"/>
                            <TextBlock Style="{StaticResource StateText}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,22,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#80FFFFFF"/>
                                <Setter TargetName="bg" Property="Background" Value="#F01C2E49"/>
                                <Setter TargetName="arrow" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="shift" Storyboard.TargetProperty="X" To="8" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="shift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#B3FFFFFF"/>
                                <Setter TargetName="arrow" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="root" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="#E4ECF5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource CyanBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="4" Background="#CC101927" BorderBrush="#26FFFFFF"
                                BorderThickness="1" Padding="14,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{TemplateBinding Background}" Margin="0,1,9,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource StateText}" Margin="10,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F01C2E49"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#80FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#B3FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GearBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="#C6D4E4"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="4" Background="#CC101927" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F01C2E49"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#80FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#B3FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="#9DB2C9"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#24FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingRow" TargetType="Button">
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="12" Background="#B3101927" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                            <Border x:Name="bar" HorizontalAlignment="Left" Width="4" Margin="0,12" CornerRadius="2" Background="{StaticResource GoldBrush}" Opacity="0"/>
                            <ContentPresenter Margin="26,10,24,10" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E01C2E49"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F01C2E49"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#B3FFFFFF"/>
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.85"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CatRow" TargetType="Button">
            <Setter Property="Foreground" Value="#C5D3E3"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Margin="0,0,0,6" Padding="18,13,14,13" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E01C2E49"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#B3FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7FC4FF"/>
            <Setter Property="Margin" Value="4,14,0,8"/>
        </Style>

        <Style x:Key="BoxTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#8FA3BA"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="GameTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#C5D3E3"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>
        <Style x:Key="Box" TargetType="Border">
            <Setter Property="Width" Value="600"/>
            <Setter Property="Padding" Value="30,26,30,22"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C80F1A2B" Offset="0"/>
                        <GradientStop Color="#B008101C" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="44" ShadowDepth="0" Opacity="0.65" Color="Black"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BoxCached" TargetType="Border" BasedOn="{StaticResource Box}">
            <Setter Property="CacheMode"><Setter.Value><BitmapCache/></Setter.Value></Setter>
        </Style>
        <Style x:Key="PaneBox" TargetType="Border" BasedOn="{StaticResource Box}">
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Background" Value="#F00B1422"/>
            <Setter Property="BorderBrush" Value="#3AFFFFFF"/>
        </Style>
        <Style x:Key="NoBtn" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource NoBtn}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="#59FFFFFF" Margin="3,0"/>
                                    </ControlTemplate></Thumb.Template></Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource NoBtn}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#7FC4FF"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Col1" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.55"/>
                    <DoubleAnimation Storyboard.TargetName="Col1Shift" Storyboard.TargetProperty="Y" From="26" To="0" Duration="0:0:0.55">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid ClipToBounds="True">
        <Grid x:Name="UiBack" IsHitTestVisible="False">
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0A1019" Offset="0"/>
                    <GradientStop Color="#08111F" Offset="0.55"/>
                    <GradientStop Color="#050810" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <MediaElement x:Name="HybridVideo" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                      Stretch="UniformToFill" IsMuted="True" IsHitTestVisible="False" MediaEnded="HybridVideo_Ended"
                      RenderOptions.BitmapScalingMode="LowQuality"/>
        <Rectangle x:Name="HybridDim" Visibility="Collapsed" Fill="#88050810" IsHitTestVisible="False"/>
        <Rectangle CacheMode="BitmapCache">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.88,0.5" RadiusX="0.7" RadiusY="0.9" GradientOrigin="0.88,0.5">
                    <GradientStop Color="#3A2F7FD1" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Opacity="0.05" IsHitTestVisible="False" CacheMode="BitmapCache">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute"
                              Viewbox="0,0,64,64" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,0 L64,0 M0,0 L0,64">
                            <GeometryDrawing.Pen>
                                <Pen Brush="White" Thickness="1"/>
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Ellipse Width="1180" Height="1180" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,-520,0" StrokeThickness="46" Opacity="0.20" IsHitTestVisible="False" CacheMode="BitmapCache">
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#9FE2FF" Offset="0"/>
                    <GradientStop Color="#2F7FD1" Offset="0.6"/>
                    <GradientStop Color="#0E2A4D" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Stroke>
            <Ellipse.Effect>
                <DropShadowEffect Color="#5DB4FF" BlurRadius="70" ShadowDepth="0" Opacity="0.7"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="960" Height="960" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,-410,0" Stroke="#5DB4FF" StrokeThickness="2" Opacity="0.25" IsHitTestVisible="False" CacheMode="BitmapCache"/>

        </Grid>

        <Grid x:Name="UiMain">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0">
            <Button Style="{StaticResource WinBtn}" Content="—" Click="Minimize_Click" ToolTip="Minimize"/>
            <Button x:Name="WinModeBtn" Style="{StaticResource WinBtn}" Content="❐" Click="WindowMode_Click" ToolTip="Windowed"/>
            <Button Style="{StaticResource CloseBtn}" Content="✕" Click="Exit_Click" ToolTip="Exit (Esc)"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,24,0,0">
            <Image Source="Assets/logo.png" Height="62" Width="62" RenderOptions.BitmapScalingMode="HighQuality" CacheMode="BitmapCache">
                <Image.Effect><DropShadowEffect Color="#5DB4FF" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/></Image.Effect>
            </Image>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="AHFMC: A Halo Fan-Made Collection" Foreground="White" FontSize="32" FontWeight="Light"/>
                <TextBlock Margin="2,2,0,0" FontSize="15" Foreground="#9DB2C9">
                    <Run Text="A fan made project by "/><Hyperlink NavigateUri="https://github.com/WhyWasThisNotAThing" RequestNavigate="Link_RequestNavigate">WhyWasThisNotAThing</Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,94,0,0">
            <Ellipse Width="8" Height="8" Fill="{StaticResource SteamBrush}" Margin="0,1,7,0"/>
            <TextBlock Text="Steam" Foreground="#9DB2C9" FontSize="14" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Ellipse Width="8" Height="8" Fill="{StaticResource StoreBrush}" Margin="0,1,7,0"/>
            <TextBlock Text="Microsoft Store" Foreground="#9DB2C9" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,176,0">
            <Button Style="{StaticResource Pill}" Content="News" Click="News_Click" Margin="0,0,10,0"/>
            <Button x:Name="ChatBtn" Style="{StaticResource Pill}" Background="{StaticResource GoldBrush}" Content="Chat"
                    Click="Chat_Click" Margin="0,0,10,0"/>
            <Button Style="{StaticResource Pill}" Content="Credits" Click="Credits_Click" Margin="0"/>
        </StackPanel>

        <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="40,128,40,70"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel x:Name="Col1" Orientation="Horizontal">
                <StackPanel.RenderTransform><TranslateTransform x:Name="Col1Shift"/></StackPanel.RenderTransform>

                <StackPanel Width="600" Margin="0,0,40,0" VerticalAlignment="Top">
                <Border Style="{StaticResource BoxCached}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="AHFMC: A Halo Fan-Made Collection" Style="{StaticResource BoxTitle}"/>
                        <Rectangle Height="3" Width="64" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Margin="1,12,0,24" Fill="{StaticResource CyanBrush}"/>
                        <Button x:Name="ReachBtn" Style="{StaticResource Card}" Click="Reach_Click">
                            <StackPanel>
                                <TextBlock Text="Halo Reach Renaissance" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="ReachSub" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CommunityBtn" Style="{StaticResource Card}" Click="Community_Click">
                            <StackPanel>
                                <TextBlock Text="Open Community Edition" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="OceSub" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="GravemindBtn" Style="{StaticResource Card}" Click="Gravemind_Click">
                            <StackPanel>
                                <TextBlock Text="Halo 2 Gravemind" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="GravemindSub" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="Halo3Btn" Style="{StaticResource Card}" Click="Halo3_Click">
                            <StackPanel>
                                <TextBlock Text="Halo 3 Reclaimer" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="Halo3Sub" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="GroundsideBtn" Style="{StaticResource Card}" Click="Groundside_Click" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Project Groundside" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="GroundsideSub" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                        </Button>
