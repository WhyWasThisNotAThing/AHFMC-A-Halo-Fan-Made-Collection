              KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource PaneBox}" Width="1060" MaxHeight="820" Padding="36,30,36,24" Margin="24,28" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource BoxTitle}"/>
                        <Rectangle Height="3" Width="64" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Margin="1,12,0,8" Fill="{StaticResource CyanBrush}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="SettingsCats"/>
                        </ScrollViewer>
                        <Border Grid.Column="1" Margin="18,0,0,0" CornerRadius="14" Background="#66060B14" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="18,16,6,8">
                            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" Padding="0,0,12,0">
                                <StackPanel x:Name="SettingsList"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="SettingsClose" Style="{StaticResource Pill}" Content="Close" Click="CloseSettings_Click" HorizontalAlignment="Left" Margin="0"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#6B829C" FontSize="14"
                                   Text="↑ ↓  Choose        →  Open        ← →  Change        Esc / B  Back"/>
                    </Grid>
                </Grid>
