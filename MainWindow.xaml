                    </StackPanel>
                </Border>

                    <Border Style="{StaticResource BoxCached}" Margin="0,0,0,18" Padding="30,22,30,22">
                        <StackPanel>
                            <TextBlock Text="Halo 5: Forge" Style="{StaticResource GameTitle}"/>
                            <TextBlock x:Name="PlayedForge" Style="{StaticResource RowSub}" Visibility="Collapsed" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource Pill}" Background="{StaticResource StoreBrush}" Content="Microsoft Store" Tag="ms-windows-store://pdp/?ProductId=9nblggh51mwp|Halo 5: Forge" Click="OpenUri_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                <Border Style="{StaticResource BoxCached}" Margin="0,0,0,18" Padding="30,22,30,22">
                        <StackPanel>
                            <TextBlock Text="Halo Infinite" Style="{StaticResource GameTitle}"/>
                            <TextBlock x:Name="PlayedInfinite" Style="{StaticResource RowSub}" Visibility="Collapsed" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource Pill}" Background="{StaticResource SteamBrush}" Content="Steam" Tag="steam://run/1240440|Halo Infinite" Click="OpenUri_Click"/>
                            <Button Style="{StaticResource Pill}" Background="{StaticResource StoreBrush}" Content="Microsoft Store" Tag="ms-windows-store://search/?query=Halo%20Infinite|Halo Infinite" Click="OpenUri_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                <Border Style="{StaticResource BoxCached}" Margin="0,0,0,0" Padding="30,22,30,22">
                        <StackPanel>
                            <TextBlock Text="Halo: Campaign Evolved (2026)" Style="{StaticResource GameTitle}"/>
                            <TextBlock x:Name="PlayedCampaignEvolved" Style="{StaticResource RowSub}" Visibility="Collapsed" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource Pill}" Background="{StaticResource SteamBrush}" Content="Steam" Tag="steam://run/2806050|Halo: Campaign Evolved (2026)" Click="OpenUri_Click"/>
                            <Button Style="{StaticResource Pill}" Background="{StaticResource StoreBrush}" Content="Microsoft Store" Tag="ms-windows-store://search/?query=Halo%20Campaign%20Evolved|Halo: Campaign Evolved (2026)" Click="OpenUri_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Viewbox>

        <StackPanel Width="1240" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22">
            <Grid>
                <TextBlock x:Name="Status" Foreground="#9DB2C9" FontSize="15" Margin="2,0,0,8" Text=" "/>
                <Button x:Name="CancelDlBtn" Style="{StaticResource Pill}" Content="Cancel download" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,0,0" Click="CancelDl_Click"/>
            </Grid>
            <ProgressBar x:Name="Progress" Height="4" Visibility="Hidden"
                         Foreground="#5DB4FF" Background="#1A2638" BorderThickness="0"/>
        </StackPanel>

        <Grid x:Name="CreditsPane" Visibility="Collapsed" Background="#E6050810" MouseDown="CreditsScrim_MouseDown"
              KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource PaneBox}" Width="720" MaxHeight="820" Padding="40,34,26,32" Margin="24,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer x:Name="CreditsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Credits" Style="{StaticResource BoxTitle}"/>
                    <Rectangle Height="3" Width="64" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Margin="1,12,0,22" Fill="{StaticResource CyanBrush}"/>

                    <TextBlock TextWrapping="Wrap" Foreground="#C5D3E3" FontSize="16" LineHeight="24">
                        AHFMC: A Halo Fan-Made Collection is a fan made project. It is not made by, affiliated with or endorsed by Microsoft, Xbox Game Studios or Halo Studios. Halo and its related names, logos and artwork belong to Microsoft.
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" Foreground="#C5D3E3" FontSize="16" LineHeight="24" Margin="0,18,0,0">
                        <Run Text="Launcher made by "/><Hyperlink NavigateUri="https://github.com/WhyWasThisNotAThing" RequestNavigate="Link_RequestNavigate">WhyWasThisNotAThing</Hyperlink>
                    </TextBlock>

                    <TextBlock Text="The fan projects it launches belong to their own creators" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#C5D3E3" FontSize="15" LineHeight="23">
                        <Run Text="Halo 3 Reclaimer: downloaded from the "/><Hyperlink NavigateUri="https://github.com/ProjectReclaimer/project-reclaimer-releases" RequestNavigate="Link_RequestNavigate">Project Reclaimer releases</Hyperlink><LineBreak/>
                        <Run Text="Halo Reach Renaissance: downloaded from the "/><Hyperlink NavigateUri="https://github.com/NETF1ix/reach-renaissance-releases" RequestNavigate="Link_RequestNavigate">NETF1ix releases</Hyperlink><LineBreak/>
                        <Run Text="Halo 2 Gravemind: downloaded from the "/><Hyperlink NavigateUri="https://github.com/BriRoz1/h2gravemind-releases/releases/" RequestNavigate="Link_RequestNavigate">h2gravemind-releases (BriRoz1)</Hyperlink><LineBreak/>
                        <Run Text="Open Community Edition: "/><Hyperlink NavigateUri="https://opencommunityedition.com/" RequestNavigate="Link_RequestNavigate">opencommunityedition.com</Hyperlink><LineBreak/>
                        <Run Text="Project Groundside: join the "/><Hyperlink NavigateUri="https://discord.gg/nRusWYMdYu" RequestNavigate="Link_RequestNavigate">Project Groundside Discord</Hyperlink>
