            <Grid x:Name="DropLayer" Visibility="Collapsed" Background="#99050810" MouseDown="DropLayer_MouseDown">
                <Border Style="{StaticResource PaneBox}" Width="460" Padding="22,20,22,14" CornerRadius="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="DropTitle" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="2,0,0,12"/>
                        <StackPanel x:Name="DropItems"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        </Grid>

        <Grid x:Name="ClassicPane" Visibility="Collapsed" Background="Black">
            <wv2:WebView2 x:Name="ClassicView"/>
        </Grid>

        <Grid x:Name="BrowserPane" Visibility="Collapsed" Background="#070B12">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Style="{StaticResource WinBtn}" Width="170" FontSize="15"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,8,0,0"
                    Content="←  Back to launcher" ToolTip="Shift + Esc" Click="CloseBrowser_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,18,0">
                <Button Style="{StaticResource WinBtn}" Content="—" Click="Minimize_Click" ToolTip="Minimize"/>
                <Button x:Name="WinModeBtn2" Style="{StaticResource WinBtn}" Content="❐" Click="WindowMode_Click" ToolTip="Windowed"/>
                <Button Style="{StaticResource CloseBtn}" Content="✕" Click="Exit_Click" ToolTip="Exit launcher"/>
            </StackPanel>
            <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
        </Grid>

        <Grid x:Name="UiTop">
        <TextBlock x:Name="ControllerHint" Text="↑ ↓ ← →  Move        Enter / A  Select        Esc / B  Back"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,96,22"
                   Foreground="#6B829C" FontSize="14"/>

        <Button x:Name="SettingsBtn" Style="{StaticResource GearBtn}" Content="&#xE713;" ToolTip="Settings"
                AutomationProperties.Name="Settings" Click="Settings_Click"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,52"/>

        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,28,22" Foreground="#6B829C" FontSize="14"/>

        <Grid x:Name="SetupPane" Visibility="Collapsed" Background="#F2050810"
              KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource Box}" Width="1000" Padding="36,30,36,24" Margin="0,30" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SetupTitle" Text="Welcome" Style="{StaticResource BoxTitle}"/>
                        <Rectangle Height="3" Width="64" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Margin="1,12,0,12" Fill="{StaticResource GoldBrush}"/>
                        <TextBlock x:Name="SetupIntro" TextWrapping="Wrap" Foreground="#C5D3E3" FontSize="16" LineHeight="24"/>
                    </StackPanel>
                    <ScrollViewer x:Name="SetupScroll" Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" Padding="0,0,12,0">
                        <StackPanel x:Name="SetupList"/>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="SetupStart" Style="{StaticResource Pill}" Background="{StaticResource GoldBrush}" Content="Start" Click="SetupStart_Click" HorizontalAlignment="Left" Margin="0"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#6B829C" FontSize="14"
                                   Text="↑ ↓  Choose        ← →  Change        Enter / A  Select"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="CountdownPane" Visibility="Collapsed" Background="#D9050810">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Text="3" FontSize="280" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><ScaleTransform x:Name="CountScale"/></TextBlock.RenderTransform>
                    <TextBlock.Effect><DropShadowEffect Color="#5DB4FF" BlurRadius="60" ShadowDepth="0" Opacity="0.85"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="CountStatus" Text=" " FontSize="22" Foreground="#9DB2C9" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="DialogPane" Visibility="Collapsed" Background="#E6050810"
              KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource Box}" Width="720" Padding="40,34,40,30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Style="{StaticResource BoxTitle}"/>
                    <Rectangle Height="3" Width="64" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Margin="1,12,0,22" Fill="{StaticResource GoldBrush}"/>
                    <TextBlock x:Name="DialogText" TextWrapping="Wrap" Foreground="#C5D3E3" FontSize="16" LineHeight="24"/>
                    <TextBox x:Name="DialogInput" Visibility="Collapsed" MaxLength="40" Margin="0,18,0,0" FontSize="18" Padding="12,9"
                             Background="#101927" Foreground="White" CaretBrush="White" SelectionBrush="#2F7FD1"
                             BorderBrush="#30B1F3" BorderThickness="1"/>
                    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                        <Button x:Name="DialogYes" Style="{StaticResource Pill}" Background="{StaticResource GoldBrush}" Click="DialogYes_Click"/>
                        <Button x:Name="DialogNo" Style="{StaticResource Pill}" Click="DialogNo_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        </Grid>

        <Grid x:Name="ChatPane" Visibility="Collapsed" Background="{StaticResource Bg}" Width="640" HorizontalAlignment="Right">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Chat" Foreground="White" FontSize="20" FontWeight="Light" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button Style="{StaticResource WinBtn}" Width="120" FontSize="15"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,14,0"
                    Content="✕  Close" ToolTip="Close the chat panel (it keeps running in the background)" Click="CloseChat_Click"/>
            <Grid x:Name="ChatHost" Grid.Row="1"/>
            <Border Grid.RowSpan="2" BorderBrush="#552F7FD1" BorderThickness="1,0,0,0" IsHitTestVisible="False"/>
        </Grid>

        <Border x:Name="ChatToast" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,22,0"
                MinWidth="300" MaxWidth="420" Background="#F00F1A2B" BorderBrush="#AA2F7FD1" BorderThickness="1" CornerRadius="10"
                Padding="16,12" Cursor="Hand" MouseLeftButtonUp="ChatToast_Click">
            <StackPanel>
                <TextBlock x:Name="ToastTitle" Foreground="#FFD779" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ToastBody" Foreground="White" FontSize="14" TextWrapping="Wrap" MaxHeight="64" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid x:Name="StartupCover" Visibility="Collapsed" Background="Black"/>
    </Grid>
</Window>
