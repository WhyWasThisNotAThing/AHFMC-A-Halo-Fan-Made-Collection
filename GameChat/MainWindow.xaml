<Window x:Class="AHFMCChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat" Width="1040" Height="700" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        Closed="Window_Closed" Activated="Window_Activated">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="14,14,14,8">
            <TextBlock x:Name="UserText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="DMs and parties are end-to-end encrypted"
                       Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Settings" Click="Settings_Click" Padding="8,4" Margin="0,0,6,0"/>
              <Button Content="Lock" Click="Lock_Click" Padding="8,4"/>
            </StackPanel>
          </StackPanel>

          <ListBox Grid.Row="1" x:Name="NavList" ItemContainerStyle="{StaticResource NavItem}"
                   SelectionChanged="NavList_SelectionChanged">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}"
                               FontSize="11" FontWeight="SemiBold" Margin="14,12,0,4"/>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Border DockPanel.Dock="Right" Background="{StaticResource Accent}" CornerRadius="9"
                          MinWidth="18" Padding="5,0" VerticalAlignment="Center"
                          Visibility="{Binding HasUnread, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding Unread}" FontSize="11" Foreground="White"
                               HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{Binding Icon}" Width="18" Foreground="{StaticResource Muted}"/>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Margin="10">
            <Button Content="+  New direct message" Click="NewDm_Click" Margin="0,0,0,6"/>
            <Button Content="+  New party" Click="NewParty_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,12" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnAccept" Style="{StaticResource Primary}" Content="Accept invite" Click="Accept_Click" Margin="6,0,0,0"/>
              <Button x:Name="BtnFingerprint" Content="Safety code" Click="Fingerprint_Click" Margin="6,0,0,0"/>
              <Button x:Name="BtnVerify" Content="Mark verified" Click="Verify_Click" Margin="6,0,0,0"/>
              <Button x:Name="BtnBlock" Content="Block" Click="Block_Click" Margin="6,0,0,0"/>
              <Button x:Name="BtnReport" Content="Report" Click="Report_Click" Margin="6,0,0,0"/>
              <Button x:Name="BtnMembers" Content="Members" Click="Members_Click" Margin="6,0,0,0"/>
              <Button x:Name="BtnInvite" Content="Invite" Click="Invite_Click" Margin="6,0,0,0"/>
              <Button x:Name="BtnKick" Style="{StaticResource DangerButton}" Content="Kick" Click="Kick_Click" Margin="6,0,0,0"/>
              <Button x:Name="BtnLeave" Style="{StaticResource DangerButton}" Content="Leave" Click="Leave_Click" Margin="6,0,0,0"/>
              <Button x:Name="BtnDisband" Style="{StaticResource DangerButton}" Content="Disband" Click="Disband_Click" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Border>

        <Border x:Name="Banner" Grid.Row="1" Padding="18,6">
          <TextBlock x:Name="BannerText" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <ListBox x:Name="MsgList" Grid.Row="2" ItemContainerStyle="{StaticResource PlainItem}" Margin="0,6">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="18,5">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding From}" FontWeight="SemiBold" Foreground="{Binding NameBrush}"/>
                  <TextBlock Text=" ✓" Foreground="{StaticResource Ok}"
                             Visibility="{Binding Verified, Converter={StaticResource B2V}}"/>
                  <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Muted}"
                             FontSize="11" Margin="8,2,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="Composer" Grid.Row="3" Padding="14"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Send"
                    Click="Send_Click" Margin="8,0,0,0" Padding="18,7"/>
            <TextBox x:Name="Input" MaxLength="500" KeyDown="Input_KeyDown"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0" Padding="12,4">
      <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="11"
                 Text="Connected." TextTrimming="CharacterEllipsis"/>
    </Border>

    <Border x:Name="LockOverlay" Grid.RowSpan="2" Background="{StaticResource Bg}" Visibility="Collapsed" Panel.ZIndex="100">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
        <TextBlock Text="Locked" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="Enter your encryption passphrase to continue." Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>
        <PasswordBox x:Name="LockBox" Margin="0,0,0,10" KeyDown="LockBox_KeyDown"/>
        <Button Content="Unlock" Style="{StaticResource Primary}" Click="LockUnlock_Click"/>
        <TextBlock x:Name="LockError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
