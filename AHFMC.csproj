<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AHFMC</AssemblyName>
    <RootNamespace>AHFMC</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="GameChat\**\*.sql;GameChat\README.md" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\countdown-beep.wav" LogicalName="Sounds\beep.wav" />
    <EmbeddedResource Include="Assets\countdown-go.wav" LogicalName="Sounds\go.wav" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ClassicHalo\**\*.*" Exclude="ClassicHalo\assets\ui\bg-720.mp4;ClassicHalo\assets\ui\bg-1080.mp4;ClassicHalo\assets\ui\bg.mp3"
                      LogicalName="ClassicHalo\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\HaloGameLogo\*.*"
                      LogicalName="ClassicHalo\assets\logos\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
